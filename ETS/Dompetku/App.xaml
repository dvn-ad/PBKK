<Application x:Class="Dompetku.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Dompetku.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:CurrencyConverter x:Key="CurrencyConverter"/>
            <converters:TransactionTypeColorConverter x:Key="TransactionTypeColorConverter"/>
            <converters:HexToBrushConverter x:Key="HexToBrushConverter"/>
            <converters:BudgetStatusColorConverter x:Key="BudgetStatusColorConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

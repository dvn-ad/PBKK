<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color Palette -->
    <Color x:Key="ColorPrimary">#2563EB</Color>
    <Color x:Key="ColorPrimaryHover">#1D4ED8</Color>
    <Color x:Key="ColorPrimaryLight">#EFF6FF</Color>

    <Color x:Key="ColorSidebarBg">#0F172A</Color>
    <Color x:Key="ColorSidebarItemHover">#1E293B</Color>
    <Color x:Key="ColorSidebarText">#94A3B8</Color>
    <Color x:Key="ColorSidebarTextActive">#FFFFFF</Color>

    <Color x:Key="ColorAppBg">#F8FAFC</Color>
    <Color x:Key="ColorCardBg">#FFFFFF</Color>
    <Color x:Key="ColorBorder">#E2E8F0</Color>

    <Color x:Key="ColorTextPrimary">#0F172A</Color>
    <Color x:Key="ColorTextSecondary">#64748B</Color>
    <Color x:Key="ColorTextMuted">#94A3B8</Color>

    <Color x:Key="ColorSuccess">#16A34A</Color>
    <Color x:Key="ColorDanger">#DC2626</Color>
    <Color x:Key="ColorWarning">#F59E0B</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}"/>
    <SolidColorBrush x:Key="BrushPrimaryHover" Color="{StaticResource ColorPrimaryHover}"/>
    <SolidColorBrush x:Key="BrushPrimaryLight" Color="{StaticResource ColorPrimaryLight}"/>

    <SolidColorBrush x:Key="BrushSidebarBg" Color="{StaticResource ColorSidebarBg}"/>
    <SolidColorBrush x:Key="BrushSidebarItemHover" Color="{StaticResource ColorSidebarItemHover}"/>
    <SolidColorBrush x:Key="BrushSidebarText" Color="{StaticResource ColorSidebarText}"/>
    <SolidColorBrush x:Key="BrushSidebarTextActive" Color="{StaticResource ColorSidebarTextActive}"/>

    <SolidColorBrush x:Key="BrushAppBg" Color="{StaticResource ColorAppBg}"/>
    <SolidColorBrush x:Key="BrushCardBg" Color="{StaticResource ColorCardBg}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>

    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}"/>

</ResourceDictionary>

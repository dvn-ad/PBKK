<Window x:Class="Dompetku.Views.Dialogs.TransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transfer Saldo Antar Dompet" Height="480" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushAppBg}">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Transfer Saldo" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                <TextBlock Text="Pindahkan saldo antar rekening, kartu, atau dompet" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Content Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- From Wallet -->
                    <TextBlock Text="Dari Dompet (Asal) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbFromWallet" Style="{StaticResource ModernComboBox}" DisplayMemberPath="WalletName" SelectedValuePath="WalletId" Margin="0,0,0,14"/>

                    <!-- To Wallet -->
                    <TextBlock Text="Ke Dompet (Tujuan) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbToWallet" Style="{StaticResource ModernComboBox}" DisplayMemberPath="WalletName" SelectedValuePath="WalletId" Margin="0,0,0,14"/>

                    <!-- Amount -->
                    <TextBlock Text="Nominal Transfer (Rp) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtAmount" Style="{StaticResource ModernTextBox}" FontSize="15" FontWeight="Bold" Margin="0,0,0,14"/>

                    <!-- Admin Fee -->
                    <TextBlock Text="Biaya Admin (Rp)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtAdminFee" Text="0" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                    <!-- Date -->
                    <TextBlock Text="Tanggal Transfer *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <DatePicker x:Name="DpDate" Height="38" Margin="0,0,0,14"/>

                    <!-- Notes -->
                    <TextBlock Text="Catatan" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtNotes" Style="{StaticResource ModernTextBox}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Batal" Style="{StaticResource BtnOutline}" Width="90" Click="OnCancelClick" Margin="0,0,10,0"/>
                <Button Content="Kirim Saldo" Style="{StaticResource BtnPrimary}" Click="OnSaveClick" Padding="20,8"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="Dompetku.Views.Dialogs.WalletDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kelola Dompet / Akun" Height="430" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushAppBg}">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="TxtTitle" Text="Tambah Dompet Baru" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                <TextBlock Text="Atur akun kas, bank, atau dompet digital Anda" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Form Content -->
            <StackPanel Grid.Row="1">
                <!-- Name -->
                <TextBlock Text="Nama Dompet / Rekening *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                <!-- Type -->
                <TextBlock Text="Jenis Akun *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbType" Style="{StaticResource ModernComboBox}" Margin="0,0,0,14">
                    <ComboBoxItem Content="Cash (Uang Tunai)" Tag="Cash" IsSelected="True"/>
                    <ComboBoxItem Content="Bank (Rekening Bank)" Tag="Bank"/>
                    <ComboBoxItem Content="E-Wallet (Dompet Digital)" Tag="E-Wallet"/>
                    <ComboBoxItem Content="Other (Lainnya)" Tag="Other"/>
                </ComboBox>

                <!-- Initial Balance -->
                <TextBlock x:Name="LblBalance" Text="Saldo Awal (Rp)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtBalance" Text="0" Style="{StaticResource ModernTextBox}" FontSize="14" FontWeight="Bold" Margin="0,0,0,14"/>

                <!-- Color Code -->
                <TextBlock Text="Warna Penanda" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbColor" Style="{StaticResource ModernComboBox}">
                    <ComboBoxItem Content="Biru (#2563EB)" Tag="#2563EB" IsSelected="True"/>
                    <ComboBoxItem Content="Hijau (#16A34A)" Tag="#16A34A"/>
                    <ComboBoxItem Content="Ungu (#8B5CF6)" Tag="#8B5CF6"/>
                    <ComboBoxItem Content="Oranye (#F97316)" Tag="#F97316"/>
                    <ComboBoxItem Content="Merah (#DC2626)" Tag="#DC2626"/>
                    <ComboBoxItem Content="Teal (#0D9488)" Tag="#0D9488"/>
                </ComboBox>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Batal" Style="{StaticResource BtnOutline}" Width="90" Click="OnCancelClick" Margin="0,0,10,0"/>
                <Button Content="Simpan" Style="{StaticResource BtnPrimary}" Width="100" Click="OnSaveClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="Dompetku.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Masuk ke DOMPETKU" Height="640" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BrushAppBg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="36,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Logo & Header -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <!-- App Icon -->
                    <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource BrushPrimary}" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="💳" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="DOMPETKU" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sistem Informasi Keuangan Pribadi" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>

                    <TextBlock Text="{Binding HeaderTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>

                <!-- Input Form Card -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="20">
                    <StackPanel>

                        <!-- Error Alert -->
                        <Border x:Name="AlertBorder" Background="#FEE2E2" CornerRadius="6" Padding="10,8" Margin="0,0,0,14"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Full Name (Only on Register Mode) -->
                        <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,14">
                            <TextBlock Text="Nama Lengkap *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <!-- Username -->
                        <TextBlock Text="Username *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                        <!-- Password -->
                        <TextBlock Text="Password *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="TxtPasswordBox" Height="38" FontSize="13" VerticalContentAlignment="Center" Padding="10,6" Margin="0,0,0,20"
                                     PasswordChanged="OnPasswordChanged"/>

                        <!-- Submit Button -->
                        <Button Content="{Binding SubmitButtonText}" Style="{StaticResource BtnPrimary}" Height="42" FontSize="14"
                                Command="{Binding SubmitCommand}" Margin="0,0,0,14"/>

                        <!-- Toggle Mode Link -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ToggleModePrompt}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding ToggleModeActionText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" 
                                       Cursor="Hand" Margin="6,0,0,0">
                                <TextBlock.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding ToggleModeCommand}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </ScrollViewer>
</Window>

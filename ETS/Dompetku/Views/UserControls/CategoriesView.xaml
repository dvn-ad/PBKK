<UserControl x:Class="Dompetku.Views.UserControls.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Dompetku.Models"
             Background="{StaticResource BrushAppBg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- Top Header & Actions -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Kelola Kategori" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Kustomisasi pos pos pengeluaran dan sumber pemasukan sesuai kebutuhan Anda" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Content="+ Tambah Kategori" Style="{StaticResource BtnPrimary}" Click="OnAddCategoryClick" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- 2-Column: Expense vs Income Categories -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Kategori Pengeluaran (Expense) -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource BrushDanger}" Margin="0,0,8,0"/>
                                <TextBlock Text="Kategori Pengeluaran" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ExpenseCategories.Count, StringFormat='{}{0} Kategori'}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <DataGrid ItemsSource="{Binding ExpenseCategories}" Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Warna" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="16" Height="16" CornerRadius="8" Background="{Binding ColorCode, Converter={StaticResource HexToBrushConverter}}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Nama Kategori" Binding="{Binding CategoryName}" Width="*"/>
                                <DataGridTemplateColumn Header="Aksi" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Edit" Style="{StaticResource BtnOutline}" FontSize="11" Padding="8,4" Margin="0,0,6,0"
                                                        Click="OnEditCategoryClick" Tag="{Binding}"/>
                                                <Button Content="Hapus" Style="{StaticResource BtnDanger}" FontSize="11" Padding="8,4"
                                                        Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Kategori Pemasukan (Income) -->
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="12,0,0,0" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource BrushSuccess}" Margin="0,0,8,0"/>
                                <TextBlock Text="Kategori Pemasukan" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding IncomeCategories.Count, StringFormat='{}{0} Kategori'}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <DataGrid ItemsSource="{Binding IncomeCategories}" Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Warna" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="16" Height="16" CornerRadius="8" Background="{Binding ColorCode, Converter={StaticResource HexToBrushConverter}}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Nama Kategori" Binding="{Binding CategoryName}" Width="*"/>
                                <DataGridTemplateColumn Header="Aksi" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Edit" Style="{StaticResource BtnOutline}" FontSize="11" Padding="8,4" Margin="0,0,6,0"
                                                        Click="OnEditCategoryClick" Tag="{Binding}"/>
                                                <Button Content="Hapus" Style="{StaticResource BtnDanger}" FontSize="11" Padding="8,4"
                                                        Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>

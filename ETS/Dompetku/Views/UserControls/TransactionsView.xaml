<UserControl x:Class="Dompetku.Views.UserControls.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Dompetku.Models"
             Background="{StaticResource BrushAppBg}">
    <Border Padding="28,24">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Actions -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Riwayat Transaksi" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                <TextBlock Text="Kelola, filter, dan telusuri seluruh catatan mutasi keuangan Anda" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Ekspor CSV" Style="{StaticResource BtnOutline}" Command="{Binding ExportCsvCommand}" Margin="0,0,10,0"/>
                <Button Content="+ Transaksi Baru" Style="{StaticResource BtnPrimary}" Click="OnAddTransactionClick"/>
            </StackPanel>
        </Grid>

        <!-- Filter Bar Card -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="16">
            <StackPanel>
                <!-- Filters Grid -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Dari Tanggal -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Dari Tanggal" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" Height="34"/>
                    </StackPanel>

                    <!-- Sampai Tanggal -->
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Sampai Tanggal" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}" Height="34"/>
                    </StackPanel>

                    <!-- Dompet -->
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Dompet / Rekening" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding WalletsFilter}" SelectedItem="{Binding SelectedWalletFilter, Mode=TwoWay}" DisplayMemberPath="WalletName" Height="34"/>
                    </StackPanel>

                    <!-- Kategori -->
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Kategori" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CategoriesFilter}" SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}" DisplayMemberPath="CategoryName" Height="34"/>
                    </StackPanel>

                    <!-- Tipe -->
                    <StackPanel Grid.Column="4" Margin="0,0,8,0">
                        <TextBlock Text="Tipe Transaksi" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox SelectedValue="{Binding SelectedTypeFilter, Mode=TwoWay}" SelectedValuePath="Tag" Height="34">
                            <ComboBoxItem Content="Semua Tipe" Tag="All" IsSelected="True"/>
                            <ComboBoxItem Content="Pemasukan (+)" Tag="Income"/>
                            <ComboBoxItem Content="Pengeluaran (-)" Tag="Expense"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Search Input -->
                    <StackPanel Grid.Column="5" Margin="0,0,8,0">
                        <TextBlock Text="Pencarian Catatan" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="34"/>
                    </StackPanel>

                    <!-- Reset Button -->
                    <Button Grid.Column="6" Content="Reset" Style="{StaticResource BtnOutline}" Command="{Binding ResetFilterCommand}" Height="34" VerticalAlignment="Bottom" Padding="12,0"/>
                </Grid>

                <!-- Filter Totals Summary -->
                <Grid Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Hasil Filter: " FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Transactions.Count, StringFormat='{}{0} Transaksi'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" Margin="4,0,16,0"/>

                        <TextBlock Text="Total Pemasukan: " FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalFilteredIncome, Converter={StaticResource CurrencyConverter}}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center" Margin="4,0,16,0"/>

                        <TextBlock Text="Total Pengeluaran: " FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalFilteredExpense, Converter={StaticResource CurrencyConverter}}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushDanger}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Main DataGrid Card -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Transactions}" Style="{StaticResource ModernDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tanggal" Binding="{Binding TransactionDate, StringFormat='dd MMM yyyy HH:mm'}" Width="150"/>
                    
                    <DataGridTemplateColumn Header="Tipe" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                        Background="{Binding TransactionType, Converter={StaticResource TransactionTypeColorConverter}}" Opacity="0.9">
                                    <TextBlock Text="{Binding TransactionType}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Kategori" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{Binding CategoryColor, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding CategoryName}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Dompet" Binding="{Binding WalletName}" Width="150"/>
                    <DataGridTextColumn Header="Catatan" Binding="{Binding Description}" Width="*"/>

                    <DataGridTemplateColumn Header="Nominal" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayAmountSign}" FontWeight="Bold" FontSize="13"
                                           Foreground="{Binding TransactionType, Converter={StaticResource TransactionTypeColorConverter}}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Aksi -->
                    <DataGridTemplateColumn Header="Aksi" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Hapus" Style="{StaticResource BtnDanger}" FontSize="11" Padding="8,4"
                                        Command="{Binding DataContext.DeleteTransactionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
    </Border>
</UserControl>

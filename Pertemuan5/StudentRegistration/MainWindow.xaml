<Window x:Class="StudentRegistration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration"
        Height="680"
        Width="1150"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- FORM INPUT (KIRI) -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,4,0">
                    <TextBlock Text="STUDENT REGISTRATION"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,16" />

                    <TextBlock Text="NIM *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtNim"
                             Height="34"
                             VerticalContentAlignment="Center"
                             Padding="6,0"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Nama Mahasiswa *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtNama"
                             Height="34"
                             VerticalContentAlignment="Center"
                             Padding="6,0"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Program Studi *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbProdi"
                              Height="34"
                              DisplayMemberPath="ProgramName"
                              SelectedValuePath="ProgramId"
                              VerticalContentAlignment="Center"
                              Margin="0,0,0,12"/>

                    <TextBlock Text="Tanggal Lahir" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DatePicker x:Name="dpBirthDate"
                                Height="34"
                                VerticalContentAlignment="Center"
                                Margin="0,0,0,12"/>

                    <TextBlock Text="No. Telepon" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtTelepon"
                             Height="34"
                             VerticalContentAlignment="Center"
                             Padding="6,0"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Alamat" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtAlamat"
                             Height="60"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Padding="6,4"
                             Margin="0,0,0,18" />

                    <!-- ACTION BUTTONS -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnSimpan"
                                Content="Simpan"
                                Width="95"
                                Height="36"
                                Margin="0,0,10,0"
                                Background="#0D6EFD"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="BtnSimpan_Click" />
                        <Button x:Name="btnReset"
                                Content="Reset"
                                Width="95"
                                Height="36"
                                Margin="0,0,10,0"
                                Cursor="Hand"
                                Click="BtnReset_Click" />
                        <Button x:Name="btnHapus"
                                Content="Hapus"
                                Width="95"
                                Height="36"
                                Background="#DC3545"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="BtnHapus_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- DATA TABLE / GRID (KANAN) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           Margin="0,0,0,14"
                           LastChildFill="False">
                    <TextBlock Text="DATA MAHASISWA"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left" />

                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Right"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="txtTotalMahasiswa"
                                   Text="Total Mahasiswa: 0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#0D6EFD"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0" />

                        <Button x:Name="btnRefresh"
                                Content="Refresh"
                                Width="85"
                                Height="32"
                                Cursor="Hand"
                                Click="RefreshButton_Click" />
                    </StackPanel>
                </DockPanel>

                <DataGrid x:Name="StudentDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeight="28"
                          FontSize="12"
                          SelectionChanged="StudentDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding StudentId}"
                                            Width="45"/>
                        <DataGridTextColumn Header="NIM"
                                            Binding="{Binding NIM}"
                                            Width="90"/>
                        <DataGridTextColumn Header="Nama"
                                            Binding="{Binding Name}"
                                            Width="140"/>
                        <DataGridTextColumn Header="Program Studi"
                                            Binding="{Binding ProgramName}"
                                            Width="140"/>
                        <DataGridTextColumn Header="Tanggal Lahir"
                                            Binding="{Binding BirthDate, StringFormat=dd/MM/yyyy}"
                                            Width="95"/>
                        <DataGridTextColumn Header="No. Telepon"
                                            Binding="{Binding PhoneNumber}"
                                            Width="110"/>
                        <DataGridTextColumn Header="Alamat"
                                            Binding="{Binding Address}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Dibuat"
                                            Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}"
                                            Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <StatusBar Grid.Row="1"
                   Margin="0,12,0,0"
                   Background="Transparent">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus"
                           Text="Siap"
                           Foreground="Gray"
                           FontSize="12"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
